# Google Calendar appointment schedule.
# Julio creates this in Google Calendar (2-hour slots from 8am, Mon-Sat) and
# shares the booking page. Paste the calendar.app.google/... link here.
# Leave it empty and the booking section falls back to phone and WhatsApp —
# the page never shows a broken or empty scheduler.
PUBLIC_BOOKING_URL=

# Meta (Facebook/Instagram) Pixel. Empty means no Meta script is emitted at
# all, not a disabled one.
PUBLIC_META_PIXEL_ID=

# GA4. Same rule.
PUBLIC_GA4_ID=
