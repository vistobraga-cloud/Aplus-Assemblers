---
import '../styles/global.css';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import StickyBar from '@components/StickyBar.astro';
import Analytics from '@components/Analytics.astro';

import { business } from '@data/business';
import {
  alternates,
  localePath,
  neutralPath,
  toLocale,
  getDict,
  DEFAULT_LOCALE,
} from '@i18n/index';
import { graph } from '@lib/schema';

/**
 * The page shell, shared by all three languages.
 *
 * Everything locale-dependent is derived from Astro.currentLocale rather than
 * passed in, so a page cannot render Spanish copy inside an English document
 * or emit an hreflang set that disagrees with the URL it sits on.
 */
interface Props {
  title: string;
  description: string;
  /** Extra schema.org nodes: Service, FAQPage, and so on. */
  schemaNodes?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, schemaNodes = [], ogImage = '/og-default.jpg' } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const dict = getDict(locale);

const site = Astro.site ?? new URL(business.siteUrl);
const route = neutralPath(Astro.url.pathname);
// Built from the neutral route rather than the raw pathname, so the canonical
// is the clean URL a visitor is actually served and matches this page's own
// entry in the hreflang set below. Taken straight from Astro.url.pathname it
// carried a .html extension and the two disagreed.
const canonicalUrl = new URL(localePath(locale, route), site).href;

// Reciprocal alternates: every language points at all three, including
// itself, plus x-default on English. A one-way hreflang set is ignored.
const langAlternates = alternates(route);
const ogImageUrl = new URL(ogImage, site).href;

const nodes = [...schemaNodes];
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* Runs before first paint, so a visitor who chose dark never sees a
         white flash first. Inline and tiny on purpose — a deferred script
         would be too late by definition. It only writes the attribute when
         there is an explicit stored choice; with none, the CSS media query
         decides and this does nothing. */
    }
    <script is:inline>
      try {
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      } catch (e) {
        /* Storage blocked. The media query still gives a sensible default. */
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {
      langAlternates.map((alt) => (
        <link
          rel="alternate"
          hreflang={getDict(alt.locale).htmlLang}
          href={new URL(alt.path, site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(langAlternates.find((a) => a.locale === DEFAULT_LOCALE)?.path ?? '/', site).href}
    />

    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f8f4f" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={dict.htmlLang.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {nodes.length > 0 && <script type="application/ld+json" is:inline set:html={graph(nodes)} />}

    <Analytics />
  </head>

  <body class="has-sticky-bar bg-surface text-body">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-accent-solid focus:px-4 focus:py-2 focus:text-white"
    >
      {dict.nav.skipToContent}
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <StickyBar />
  </body>
</html>
