---
import Icon from '@components/icons/Icon.astro';
import { business } from '@data/business';
import { reviews, REVIEW_PLACEHOLDER_COUNT } from '@data/reviews';
import { getDict, toLocale, fill } from '@i18n/index';

/**
 * The Thumbtack proof and the reviews, in one section.
 *
 * They used to be two: a badge strip high on the page and a carousel far below
 * it, which was the same argument told twice, on two near-identical blue
 * bands, with two different colours of star. One argument, one band, one star.
 *
 * NOT FETCHED, AND IT CANNOT BE. Thumbtack publishes no public reviews API, so
 * nothing here can pull them at runtime; scraping the profile would breach
 * their terms and this is a static build with no server to run it from. The
 * reviews are transcribed by hand into src/data/reviews.ts and attributed to
 * the platform, with a link back so anyone can check them at the source.
 *
 * THE NUMBER HAS TO WEAR THE PLATFORM. The aggregate was once four bare
 * figures in a row — 325, 4.9, 10, Top Pro — which is data, not proof. A
 * number nobody can attribute is a claim the visitor has to take on faith; the
 * same number wearing the platform that issued it is evidence. Top Pro is a
 * status Thumbtack awards and the rating is a figure it publishes, so naming
 * the source is both the honest move and the persuasive one.
 *
 * NO Review OR aggregateRating MARKUP. These were earned on Thumbtack, not
 * here. Marking up a third party's reviews on our own business node is
 * self-serving review markup — ineligible for rich results and a manual-action
 * risk. They live in visible HTML with the source named.
 *
 * COMPACT AND STACKED, AT THE CLIENT'S REQUEST. This was briefly a two-column
 * layout, proof rail beside carousel, because the section sits third on the
 * page and every pixel of its height pushes "what I do" further from a reader
 * who does not yet know what he does. Stacking costs that back, so everything
 * here is tuned tight to pay for it: the band is py-12/16 rather than
 * py-20/28, the heading is display-md rather than display-lg, the badges are
 * one flat row instead of a column of blocks, and the two attribution
 * sentences share a single line of fine print under the track.
 *
 * If this section starts growing again, that is the thing to protect. It is
 * third on the page.
 *
 * The carousel is CSS scroll-snap: it works with no JavaScript at all, by
 * swipe on a phone and by keyboard on a desktop. The two buttons are an
 * enhancement that scrolls by one card, and they hide themselves when there is
 * nothing to scroll.
 */
const dict = getDict(toLocale(Astro.currentLocale));
const proof = business.socialProof;

const vars = {
  platform: proof.platform,
  count: String(proof.reviewCount),
  year: String(proof.topProSince),
  years: String(business.operator.yearsInBusiness),
};

const profileUrl = proof.profileUrl;
const hasReviews = reviews.length > 0;
const cards = hasReviews ? reviews : Array.from({ length: REVIEW_PLACEHOLDER_COUNT });

/** Drawn from the rating, so the mark can never say 4.5 while the data says 4.9. */
const full = Math.floor(proof.rating);
const hasHalf = proof.rating - full >= 0.25;

/** Top Pro is a status, the other two are counts. Same cell, same weight. */
const facts = [
  { value: 'Top Pro', label: fill(dict.proof.topPro, vars) },
  { value: String(proof.jobsCompleted), label: dict.proof.jobs },
  { value: vars.years, label: dict.proof.years },
];

/**
 * The initials disc.
 *
 * Thumbtack shows a reviewer's name as "Shawn M." and nothing else, so there
 * is no photograph to use and inventing one would be inventing a person. Two
 * letters and a colour is what is honestly available.
 *
 * The tint is derived from the name so it is stable between builds and varies
 * down the row. Every value in the set measures at least 5:1 on its own tinted
 * disc, measured against that disc and not against white: #0175a3 and
 * #1a7a5c both failed there at 4.30 and 4.42 and were darkened, and #4f8f4f
 * never made the set at 3.9.
 */
const AVATAR_TINTS = ['#016489', '#176d52', '#3d7440', '#2b6a8f'] as const;

function initials(name: string): string {
  return name
    .split(/\s+/)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

function tintFor(name: string): string {
  let hash = 0;
  for (const char of name) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
  return AVATAR_TINTS[hash % AVATAR_TINTS.length]!;
}

/** Month and year in the reader's own language. */
function formatDate(iso: string): string {
  const [year, month] = iso.split('-').map(Number);
  if (!year || !month) return iso;
  return new Date(year, month - 1, 1).toLocaleDateString(dict.htmlLang, {
    month: 'long',
    year: 'numeric',
  });
}
---

<section class="band-reviews py-12 lg:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <p class="eyebrow text-[#8fe3c4]">{dict.reviews.eyebrow}</p>
        <h2 class="display display-md on-tt mt-2">{dict.reviews.heading}</h2>
      </div>

      {
        /* The controls sit with the heading rather than under the track, so a
           thumb on a phone is never asked to hit a target beside the thing it
           is already swiping. */
      }
      <div class="flex flex-none gap-2" data-review-controls hidden>
        <button
          type="button"
          data-review-prev
          aria-label={dict.reviews.previous}
          class="on-tt inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 transition hover:bg-white/15"
        >
          <Icon name="arrowRight" size={18} class="rotate-180" />
        </button>
        <button
          type="button"
          data-review-next
          aria-label={dict.reviews.next}
          class="on-tt inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 transition hover:bg-white/15"
        >
          <Icon name="arrowRight" size={18} />
        </button>
      </div>
    </div>

    {
      /* The badges, one flat row rather than a stack of boxes. Rating first
         because it is the figure people look for, then the three that qualify
         it. Two columns on a phone, four from sm up. */
    }
    <dl
      class="mt-6 grid grid-cols-2 gap-x-6 gap-y-5 rounded-2xl border border-white/15 bg-white/[0.06] px-5 py-4 sm:grid-cols-4"
    >
      <div>
        <dt class="flex items-center gap-2">
          <span class="display on-tt text-2xl leading-none tabular-nums">{proof.rating}</span>
          <span
            class="tt-star-band flex items-center gap-0.5"
            role="img"
            aria-label={fill(dict.proof.rating, vars)}
          >
            {
              Array.from({ length: 5 }).map((_, index) => {
                // Two stops at the same offset is a hard edge, which is what a
                // half star is. 100% fills it, 0% leaves it empty.
                const offset = index < full ? '100%' : index === full && hasHalf ? '50%' : '0%';
                return (
                  <svg viewBox="0 0 20 20" class="h-4 w-4" aria-hidden="true">
                    <defs>
                      <linearGradient id={`agg-star-${index}`}>
                        <stop offset={offset} stop-color="currentColor" />
                        <stop offset={offset} stop-color="currentColor" stop-opacity="0.24" />
                      </linearGradient>
                    </defs>
                    <path
                      fill={`url(#agg-star-${index})`}
                      d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"
                    />
                  </svg>
                );
              })
            }
          </span>
        </dt>
        <dd class="on-tt-muted mt-1 text-xs leading-snug">{fill(dict.proof.rating, vars)}</dd>
      </div>

      {
        facts.map((fact) => (
          <div>
            <dt class="display on-tt text-2xl leading-none tabular-nums">{fact.value}</dt>
            <dd class="on-tt-muted mt-1 text-xs leading-snug">{fact.label}</dd>
          </div>
        ))
      }
    </dl>

    <ul
      data-review-track
      tabindex="0"
      class="review-track mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4"
    >
        {
          cards.map((_, index) => {
            const review = hasReviews ? reviews[index] : undefined;

            return (
              <li
                class={`flex w-[85vw] max-w-sm flex-none snap-start flex-col rounded-2xl p-5 sm:w-96 ${
                  review ? 'review-card' : 'border-2 border-dashed border-white/30'
                }`}
              >
                {review ? (
                  <>
                    {/* Stars and source on one line: the rating and who issued
                        it are a single claim and should not be read apart. */}
                    <div class="flex items-center justify-between gap-3">
                      <div
                        class="tt-star flex items-center gap-0.5"
                        aria-label={`${review.rating} / 5`}
                      >
                        {Array.from({ length: 5 }).map((_, star) => (
                          <svg viewBox="0 0 20 20" class="h-[1.05rem] w-[1.05rem]" aria-hidden="true">
                            <path
                              fill="currentColor"
                              fill-opacity={star < review.rating ? '1' : '0.18'}
                              d="M10 1.6l2.5 5.4 5.9.7-4.4 4 1.2 5.8L10 14.6 4.8 17.5 6 11.7 1.6 7.7l5.9-.7z"
                            />
                          </svg>
                        ))}
                      </div>
                      <span class="tt-verified inline-flex items-center gap-1 rounded-full px-2 py-1 text-[0.6rem] font-extrabold tracking-[0.1em] uppercase">
                        <Icon name="check" size={11} />
                        {proof.platform}
                      </span>
                    </div>

                    <blockquote class="review-quote mt-4 text-[1.0625rem]">{review.text}</blockquote>

                    {/* mt-auto pins every footer to the bottom, so the row of
                        cards shares one baseline however long the quote is. */}
                    <footer class="mt-auto flex items-center gap-3 border-t border-[rgb(34_38_42/0.09)] pt-4">
                      <span
                        class="review-avatar flex h-10 w-10 flex-none items-center justify-center rounded-full text-xs font-extrabold tracking-wide"
                        style={`color: ${tintFor(review.author)}`}
                        aria-hidden="true"
                      >
                        {initials(review.author)}
                      </span>
                      <div class="min-w-0">
                        <p class="truncate text-sm font-bold">{review.author}</p>
                        <p class="review-card-meta truncate text-xs">
                          {formatDate(review.date)}
                          {review.job && <span> · {review.job}</span>}
                        </p>
                      </div>
                    </footer>
                  </>
                ) : (
                  <div class="flex h-56 flex-col items-center justify-center text-center">
                    <p class="on-tt-muted text-[0.65rem] font-extrabold tracking-[0.18em] uppercase">
                      {proof.platform}
                    </p>
                    <p class="on-tt-muted mt-3 max-w-[16rem] text-sm leading-relaxed">
                      {dict.reviews.empty}
                    </p>
                  </div>
                )}
              </li>
            );
          })
        }
    </ul>

    {
      /* Both attributions on one line of fine print: one says the reviews are
         transcribed verbatim, the other says where the figures came from and
         that he is background checked and insured. Two paragraphs of small
         print is what a compact section cannot afford. */
    }
    <div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <p class="on-tt-muted text-xs leading-relaxed">
        {fill(dict.reviews.body, vars)} {fill(dict.proof.source, vars)}
      </p>
      <a
        href={profileUrl}
        target="_blank"
        rel="noopener"
        data-cta-placement="reviews-source"
        class="text-xs font-bold whitespace-nowrap text-[#8fe3c4] hover:underline"
      >
        {fill(dict.reviews.readOn, vars)} →
      </a>
    </div>
  </div>
</section>

<style>
  .review-track {
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .review-track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .review-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  /*
   * Progressive enhancement only. Without this the track is still swipeable
   * and keyboard-scrollable; the buttons simply stay hidden, which is why they
   * ship with `hidden` set and are revealed here.
   */
  const track = document.querySelector<HTMLElement>('[data-review-track]');
  const controls = document.querySelector<HTMLElement>('[data-review-controls]');

  if (track && controls) {
    const overflows = () => track.scrollWidth > track.clientWidth + 4;

    const sync = () => {
      controls.hidden = !overflows();
    };

    const step = () => {
      const card = track.querySelector<HTMLElement>('li');
      // Fall back to most of a viewport when the card cannot be measured.
      return card ? card.offsetWidth + 20 : track.clientWidth * 0.8;
    };

    document
      .querySelector('[data-review-prev]')
      ?.addEventListener('click', () => track.scrollBy({ left: -step() }));

    document
      .querySelector('[data-review-next]')
      ?.addEventListener('click', () => track.scrollBy({ left: step() }));

    sync();
    window.addEventListener('resize', sync, { passive: true });
  }
</script>
