---
import { Image } from 'astro:assets';
import { equipmentBrands } from '@data/brands';
import { getDict, toLocale } from '@i18n/index';

/**
 * The equipment wall.
 *
 * Julio asked for the brands to be shown, and for a service business that is
 * ordinary and useful: a person with a broken NordicTrack is looking for the
 * word NordicTrack. What keeps it lawful is what is NOT said — no "authorized",
 * no "certified", no "partner" — plus the independence statement below, which
 * sits with the wall rather than hiding in the footer where nobody reads it.
 *
 * TWO THEMES, ONE PROBLEM. Brand artwork is nearly always dark ink on
 * transparency and vanishes on a dark ground. Chasing a white variant of
 * eighteen marks is not a project worth having, so every mark sits in a chip
 * that stays light in both themes.
 *
 * TYPE IS THE DEFAULT, NOT A PLACEHOLDER. A brand without a logo file
 * renders as its name set in the display face. That is deliberate: naming a
 * mark in plain type is the safest form of nominative use there is, safer
 * than reproducing the artwork, and eighteen real logo files are eighteen
 * different colours, weights and aspect ratios that read as a scrapbook
 * unless every one is redrawn to a common treatment. It is also the version a
 * search engine can read.
 *
 * Drop a file in src/assets/brands/ named after the brand's `logo` key and
 * that one brand switches to artwork; the rest stay as type.
 */
const dict = getDict(toLocale(Astro.currentLocale));

// Eager glob so a present file resolves at build time and an absent one is
// simply undefined — no per-brand import to keep in sync with the data.
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brands/*.{png,svg,webp}', {
  eager: true,
});

const wall = equipmentBrands.map((brand) => ({
  ...brand,
  art: brand.logo
    ? (logos[`/src/assets/brands/${brand.logo}.png`]?.default ??
      logos[`/src/assets/brands/${brand.logo}.svg`]?.default ??
      logos[`/src/assets/brands/${brand.logo}.webp`]?.default)
    : undefined,
}));
---

<section class="reveal mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
  <div class="max-w-2xl">
    <h2 class="display display-lg text-body">{dict.brands.heading}</h2>
    <p class="mt-5 leading-relaxed text-muted">{dict.brands.body}</p>
  </div>

  <ul class="reveal-stagger mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    {
      wall.map((brand) => (
        <li
          class={`flex h-20 items-center justify-center rounded-xl px-3 ${
            brand.art ? 'logo-chip' : 'brand-chip'
          }`}
        >
          {brand.art ? (
            <Image
              src={brand.art}
              alt={brand.name}
              height={36}
              densities={[1, 2]}
              loading="lazy"
              class="h-auto max-h-9 w-auto max-w-full object-contain"
            />
          ) : (
            <span class="display text-center text-[0.95rem] leading-tight tracking-tight text-body">
              {brand.name}
            </span>
          )}
        </li>
      ))
    }
  </ul>

  {
    /* This statement is what makes naming the marks above lawful. A page that
       lists them without it is making a different claim than it intends. */
  }
  <p
    data-brand-disclaimer
    class="mt-8 max-w-3xl border-l-2 border-line-strong pl-4 text-sm leading-relaxed text-faint"
  >
    {dict.brands.disclaimer}
  </p>
</section>

<style>
  /* The chip stays white in both themes, so its text must stay dark in both
     themes too — the themed token would turn it near-white and invisible. */
  .text-ink {
    color: #22262a;
  }
</style>
