---
import LangSwitcher from '@components/LangSwitcher.astro';

import {
  business,
  opensDisplay,
  closesDisplay,
} from '@data/business';
import { telHref, mailtoHref, phoneDisplay } from '@lib/contact';
import { getDict, toLocale, fill, localePath } from '@i18n/index';

/**
 * Footer, and also the NAP block — name, phone and service area written
 * exactly as they must appear in the Google Business Profile and every other
 * citation. Divergence between them dilutes the local signal, so all of it
 * comes from business.ts and none of it is retyped, in any language.
 */
const locale = toLocale(Astro.currentLocale);
const dict = getDict(locale);
const year = new Date().getFullYear();

// "Monday to Saturday" built from the data rather than written out, so a
// change to trading days moves the schema and all three languages together.
const days = business.openingHours.days;
const first = days[0] ?? '';
const last = days[days.length - 1] ?? '';
const dayRange = days.length > 1 ? `${first} – ${last}` : first;

const vars = {
  operator: business.operator.name,
  years: String(business.operator.yearsInBusiness),
  days: dayRange,
  opens: opensDisplay,
  closes: closesDisplay,
  radius: `${business.serviceRadius.miles} miles`,
  base: business.base.locality,
  region: business.base.region,
  methods: business.paymentAccepted.join(', '),
};
---

<footer class="mt-24 border-t border-line bg-surface-2">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="display text-xl text-body">{business.name}</p>
        <p class="mt-3 max-w-sm leading-relaxed text-muted">{fill(dict.footer.tagline, vars)}</p>

        <div class="mt-5 space-y-1.5 text-sm">
          <p>
            <a
              href={telHref}
              data-cta-placement="footer"
              class="font-bold text-accent hover:underline">{phoneDisplay}</a
            >
          </p>
          <p>
            <a href={mailtoHref} data-cta-placement="footer" class="text-muted hover:underline"
              >{business.email}</a
            >
          </p>
        </div>
      </div>

      <div>
        <h2 class="eyebrow text-body">{dict.footer.hours}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">{fill(dict.footer.hoursValue, vars)}</p>
      </div>

      <div>
        <h2 class="eyebrow text-body">{dict.footer.area}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">{fill(dict.footer.areaValue, vars)}</p>

        <div class="mt-6">
          <LangSwitcher />
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-line pt-8">
      <p class="text-sm text-faint">{fill(dict.footer.payment, vars)}</p>

      <div
        class="mt-4 flex flex-col gap-2 text-sm text-faint sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© {year} {business.name}. {dict.footer.rights}</p>
        <a href={localePath(locale, '/privacy')} class="hover:text-body">{dict.footer.privacy}</a>
      </div>
    </div>
  </div>
</footer>
