---
import { Image } from 'astro:assets';
import logo from '@assets/brand/logo.png';

import Icon from '@components/icons/Icon.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import LangSwitcher from '@components/LangSwitcher.astro';
import ServiceNav from '@components/ServiceNav.astro';

import { business } from '@data/business';
import { telHref, phoneDisplay } from '@lib/contact';
import { getDict, toLocale, localePath } from '@i18n/index';

/**
 * Header for a page paid traffic lands on.
 *
 * No navigation that LEAVES, which is the rule that matters: every outbound
 * link on an advertising landing page is an exit that is not the call button,
 * and the visitor arrived with one thing in mind.
 *
 * The service menu below is not that. Those are anchors — they scroll within
 * the page the visitor already landed on, and the call button sits above them
 * here and in the sticky bar at the bottom of the screen. Julio asked for a
 * way down to each service and this costs the page nothing it was protecting.
 *
 * Everything else here is only what a visitor needs to act or to read: the
 * mark, the language, the theme, and the number.
 */
const locale = toLocale(Astro.currentLocale);
const dict = getDict(locale);
---

<header class="sticky top-0 z-30 border-b border-line bg-surface/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2 sm:px-6 sm:py-2.5">
    <a href={localePath(locale, '/')} class="flex-none" aria-label={business.name}>
      <Image
        src={logo}
        alt={`${business.name} logo`}
        width={112}
        height={44}
        densities={[1, 2]}
        loading="eager"
        class="h-9 w-auto sm:h-11"
      />
    </a>

    <div class="flex flex-none items-center gap-2">
      <LangSwitcher class="hidden sm:block" />
      <ThemeToggle />

      <a
        href={telHref}
        data-cta-placement="header"
        class="inline-flex min-h-10 flex-none items-center gap-2 rounded-full bg-accent-solid px-4 py-2 text-sm font-extrabold text-white shadow-md press hover:opacity-90 sm:px-5"
      >
        <Icon name="phone" size={15} />
        <span class="hidden sm:inline">{phoneDisplay}</span>
        <span class="sm:hidden">{dict.nav.call}</span>
      </a>
    </div>
  </div>

  {
    /* The service menu, and on a phone the language switcher beside it rather
       than competing with the call button for thumb width. The switcher stays
       visible instead of hiding in a menu — someone who needs Spanish needs to
       see that Spanish exists without hunting for it. */
  }
  <div class="flex items-center gap-3 border-t border-line py-1.5 sm:justify-center">
    <ServiceNav />
    <div class="flex-none pr-4 sm:hidden">
      <LangSwitcher />
    </div>
  </div>
</header>
