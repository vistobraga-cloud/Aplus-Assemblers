---
/**
 * A flag, drawn, round.
 *
 * Not emoji. Flag emoji render as two-letter country codes on Windows, which
 * is a meaningful share of this traffic, and where they do render they arrive
 * in whatever style the OS ships — three different design languages in one
 * row. These are inline SVG, so they are one weight, one radius, and they
 * inherit nothing from the platform.
 *
 * Simplified on purpose: at 20px the Mexican eagle and the Spanish arms are
 * an illegible smudge that costs a kilobyte each. Every flag here is drawn to
 * its field and its geometry, which is what reads at this size and is what
 * icon sets have always done.
 *
 * The circle is a clip, not a border-radius on a rectangle, so the stripes
 * meet the edge cleanly rather than showing the corner of a square underneath.
 */
interface Props {
  country: 'us' | 'br' | 'mx' | 'es';
  size?: number;
  class?: string;
}

const { country, size = 20, class: className = '' } = Astro.props;

/** Unique per instance: two flags on one page must not share a clip id. */
const uid = `flag-${country}-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={`flag ${className}`}
  role="presentation"
  aria-hidden="true"
>
  <defs>
    <clipPath id={uid}>
      <circle cx="16" cy="16" r="16" />
    </clipPath>
  </defs>

  <g clip-path={`url(#${uid})`}>
    {
      country === 'us' && (
        <>
          {/* Thirteen stripes over the full field, canton over the top left. */}
          <rect width="32" height="32" fill="#b22234" />
          {[1, 3, 5, 7, 9, 11].map((i) => (
            <rect y={i * (32 / 13)} width="32" height={32 / 13} fill="#ffffff" />
          ))}
          <rect width="15" height={(32 / 13) * 7} fill="#3c3b6e" />
          {/* The grid sits inside the circle's chord. Starting at y=2.4, as it
              did, put the top row where the clip has already taken the field,
              and half of it disappeared. */}
          {[0, 1, 2, 3].map((row) =>
            [0, 1, 2, 3, 4].map((col) => (
              <circle
                cx={4.8 + col * 2.1 + (row % 2 ? 1.05 : 0)}
                cy={5.6 + row * 2.8}
                r="0.68"
                fill="#ffffff"
              />
            )),
          )}
        </>
      )
    }

    {
      country === 'br' && (
        <>
          <rect width="32" height="32" fill="#009b3a" />
          <path d="M16 4.4 27.6 16 16 27.6 4.4 16Z" fill="#fedf00" />
          <circle cx="16" cy="16" r="5" fill="#002776" />
          <path
            d="M11.2 14.1a11.4 11.4 0 0 1 9.7 3.3 5 5 0 0 1-.3 1.5 10.2 10.2 0 0 0-9.1-3.2 5 5 0 0 1-.3-1.6Z"
            fill="#ffffff"
          />
        </>
      )
    }

    {
      country === 'mx' && (
        <>
          {/* The tricolour alone IS the Italian flag. The arms are far too
              intricate for 20px, but something has to sit in the white band or
              the icon is simply wrong, so this is the eagle reduced to the
              silhouette that survives at this size. */}
          <rect width="32" height="32" fill="#ffffff" />
          <rect width="10.67" height="32" fill="#006847" />
          <rect x="21.33" width="10.67" height="32" fill="#ce1126" />
          <g fill="#6b4a2a">
            <ellipse cx="16" cy="16.2" rx="1.5" ry="2.6" />
            <path d="M16 14.2c-1.6-1.5-3.4-2-4.6-1.6.5 1.1 1.6 2.2 3 2.9z" />
            <path d="M16 14.2c1.6-1.5 3.4-2 4.6-1.6-.5 1.1-1.6 2.2-3 2.9z" />
            <circle cx="16" cy="12.9" r="0.95" />
          </g>
          <path d="M12.9 19.4h6.2" stroke="#2e7d32" stroke-width="1.1" stroke-linecap="round" />
          <path
            d="M14.3 12.6c1.2-.6 2.4-.2 2.9.5"
            stroke="#ce1126"
            stroke-width="0.7"
            fill="none"
            stroke-linecap="round"
          />
        </>
      )
    }

    {
      country === 'es' && (
        <>
          {/* Horizontal bands at 1:2:1, the flag's own proportion. */}
          <rect width="32" height="32" fill="#aa151b" />
          <rect y="8" width="32" height="16" fill="#f1bf00" />
        </>
      )
    }
  </g>

  {/* A hairline ring keeps a white or yellow edge from dissolving into a
      light surface. */}
  <circle cx="16" cy="16" r="15.4" fill="none" stroke="rgb(0 0 0 / 0.18)" stroke-width="1.2" />
</svg>

<style>
  .flag {
    display: block;
    flex: none;
    border-radius: 999px;
  }
</style>
