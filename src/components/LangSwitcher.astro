---
import Flag from '@components/Flag.astro';
import Icon from '@components/icons/Icon.astro';
import { alternates, neutralPath, toLocale, getDict, type Locale } from '@i18n/index';

/**
 * Language switcher.
 *
 * Built on <details>, so it opens and closes with no JavaScript and works
 * from the keyboard for free. The links are real links to real URLs, which
 * matters twice over: a crawler can follow them, and a visitor who lands on
 * the Spanish page from a Spanish advertisement can still get to English.
 *
 * Each link keeps the current route — someone reading the privacy page in
 * Portuguese who switches to Spanish lands on the Spanish privacy page, not
 * back at the top of the site.
 *
 * FLAGS, WITH THE CAVEAT WRITTEN DOWN. A flag is a country and a language is
 * not: Spanish is spoken in twenty of them, and this radius is more Dominican
 * and Guatemalan than Mexican. Spain is the flag here because it is the one
 * that reads as "the Spanish language" rather than as one nation's claim on
 * it, and because at icon size it is unmistakable where a Mexican tricolour
 * without its arms is the flag of Italy. Mexico is drawn and one word away in
 * the FLAGS map below.
 *
 * What keeps this honest is that the flag never travels alone: the language's
 * own name in its own language sits beside it in the open panel, and that name
 * is what actually identifies the option. The trigger is labelled for a screen
 * reader, which never sees a picture.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const dict = getDict(locale);
const route = neutralPath(Astro.url.pathname);
const options = alternates(route);

/** One line to change if the market calls for Spain over Mexico. */
const FLAGS: Record<Locale, 'us' | 'br' | 'mx' | 'es'> = {
  en: 'us',
  es: 'es',
  pt: 'br',
};
---

<details class={`lang relative ${className}`}>
  <summary
    aria-label={`${dict.nav.language}: ${dict.label}`}
    class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line py-1.5 pr-3 pl-1.5 text-sm font-bold text-muted press marker:content-none hover:border-line-strong hover:text-body"
  >
    <Flag country={FLAGS[locale]} size={22} />
    <span class="uppercase">{locale}</span>
  </summary>

  <ul
    class="absolute right-0 z-40 mt-2 min-w-44 overflow-hidden rounded-xl border border-line bg-raised py-1 shadow-lg"
  >
    {
      options.map((option) => (
        <li>
          <a
            href={option.path}
            hreflang={getDict(option.locale).htmlLang}
            lang={getDict(option.locale).htmlLang}
            aria-current={option.locale === locale ? 'true' : undefined}
            class="flex items-center gap-2.5 px-3.5 py-2.5 text-sm font-semibold text-muted transition-colors hover:bg-surface-2 hover:text-body aria-[current]:text-accent"
          >
            <Flag country={FLAGS[option.locale]} size={20} />
            <span class="flex-1">{option.label}</span>
            {/* Colour alone never carries state. The tick is what tells a
                colour-blind visitor which language they are already reading. */}
            {option.locale === locale && <Icon name="check" size={14} />}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  /* The panel grows out of the button it belongs to, from its top-right
     corner, not from nowhere. Closing is instant: the visitor already chose. */
  details.lang[open] > ul {
    transform-origin: top right;
    animation: lang-in 160ms var(--ease-out) both;
  }

  @keyframes lang-in {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-4px);
    }
  }
</style>

<script>
  /*
   * Close on outside click and on Escape. Without this the panel stays open
   * once tapped on a phone, which reads as broken. Twelve lines is a fair
   * price; a dropdown library would not be.
   */
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    document.querySelectorAll<HTMLDetailsElement>('details.lang[open]').forEach((panel) => {
      if (!panel.contains(target)) panel.open = false;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details.lang[open]').forEach((panel) => {
      panel.open = false;
    });
  });
</script>
